model User {
  id           Int            @id @default(autoincrement())
  username     String         @unique
  name         String
  password     String
  refreshToken RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}
